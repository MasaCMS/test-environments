# Adobe ColdFusion environment configuration
acceptEULA=YES
password=password
enableSecureProfile=false

# Extra JVM args, read by the java launcher
JDK_JAVA_OPTIONS=--add-opens=java.base/java.util.zip=ALL-UNNAMED

# MASA CMS config
URL_REWRITES="true"
MURA_ADMIN_USERNAME=admin
MURA_ADMIN_PASSWORD=admin
MURA_ADMINEMAIL=example@localhost.com
MURA_APPRELOADKEY=appreload
MURA_SITEIDINURLS="true"
MURA_INDEXFILEINURLS="true"
MURA_TESTBOX="true"
MURA_DEFAULTHASHALGORITHM=SHA-256

MURA_DATASOURCE=masadb
